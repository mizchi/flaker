import {
  "moonbit-community/toml",
  "mizchi/github/client" @github_client,
  "mizchi/github/actions" @github_actions,
  "mizchi/duckdb",
  "mizchi/zlib",
  "mizchi/flaker/contracts" @types,
  "mizchi/flaker/sampling" @sampler,
  "moonbitlang/async",
  "moonbitlang/core/string",
  "moonbitlang/core/json",
  "moonbitlang/core/builtin",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
}

supported_targets = "+native"

pkgtype(kind: "executable")

warnings = "-0055"

options(
  "native-stub": [ "shell_native.c" ],
  link: {
    "native": {
      // moon does not forward a dependency's cc-link-flags when linking an
      // executable, so libduckdb has to be named here.
      "cc-link-flags": "-L/opt/homebrew/lib -Wl,-rpath,/opt/homebrew/lib -L/usr/local/lib -Wl,-rpath,/usr/local/lib -lduckdb",
    },
  },
)
